#!/usr/bin/env python
"""GSF comparison card: KL smoother, reverse filter, or CMSSW-like GSF.

Select exactly one workflow by editing the explicit ``method`` assignment
near the top of this file. The accepted values are ``"smoother"``,
``"reverse"``, and ``"cms-like"``.

Every workflow reads the same ``CompleteTracks`` collection, which supplies
the LCIO reference in the output tuple.
"""

# Maintenance contract: whenever a configurable RecGsfTracking property is
# added, renamed, removed, or changes its default/allowed values, a dedicated
# sub-agent must audit this card and Reconstruction/RecGsfTracking/README.md
# together; the parent agent verifies both against src/GsfAlgorithm.h.

import os
from Gaudi.Configuration import *

tuplepath = ""
evtmax = 12340
inputseed = 12340
particle = 12340
inputfilename = os.path.join(tuplepath, "trk_v01.root")
# Per-job Geant4 material-step truth written by sim.py.bk.  The batch worker
# replaces this basename with the same sample-qualified name used in simulation.
truthbhinputfilename = os.path.join(tuplepath, "gsf_material_steps.root")

# Explicit workflow selection. Change this source line to "smoother",
# "reverse", or "cms-like"; no environment-variable override is used.
method = "reverse"

from Configurables import k4DataSvc
dsvc = k4DataSvc("EventDataSvc", input=inputfilename)

geometry_option = "TDR_o1_v01/TDR_o1_v01-onlyTracker.xml"
geometry_path = os.path.join(os.getenv("DETCRDROOT"), "compact", geometry_option)

from Configurables import DetGeomSvc
geosvc = DetGeomSvc("GeomSvc")
geosvc.compact = geometry_path

from Configurables import PodioInput
podioinput = PodioInput("PodioReader", collections=[
    "MCParticle",
    "VXDCollection",
    "ITKBarrelCollection", "ITKEndcapCollection",
    "TPCCollection",
    "OTKBarrelCollection", "OTKEndcapCollection",
    "VXDTrackerHits",
    "ITKBarrelTrackerHits", "ITKEndcapTrackerHits",
    "TPCTrackerHits",
    "OTKBarrelTrackerHits", "OTKEndcapTrackerHits",
    "VXDTrackerHitAssociation",
    "ITKBarrelTrackerHitAssociation", "ITKEndcapTrackerHitAssociation",
    "TPCTrackerHitAss",
    "OTKBarrelTrackerHitAssociation", "OTKEndcapTrackerHitAssociation",
    "EcalCluster",
    "CompleteTracks",
])

from Configurables import RecGsfTracking, TrackSystemSvc, GearSvc
tracksys = TrackSystemSvc("TrackSystemSvc")
gearsvc = GearSvc("GearSvc")

gsf = RecGsfTracking("RecGsfTracking")
gsf.ElectronHypothesis = True
# Common options used by the same-code smoother/reverse/CMS-like comparisons.
# The production default is CEPC2GeV85StepConditioned. Default-off BH controls are
# CEPC2GeV85StepConditioned6, CEPCRuntimeGenericGrid5Clear,
# CEPCRuntimeCategoryAligned5Clear, and ActsAtlas. The two CEPCRuntime models
# are topology-clear interval-fit candidates and are not production validated;
# this maintained campaign card currently selects the generic-grid control.
gsf.BHModel = "CEPCRuntimeGenericGrid5Clear" #"CEPC2GeV85StepConditioned"
# Production default; use CurrentSurface only as an explicit material control.
gsf.MaterialPathMode = "DD4hepBetweenSurfaces"
gsf.BHSplitThreshold = 1.0e-4

# Strict Geant4 eBrem-loss oracle for diagnostic A/B tests only.  The maintained
# batch card points at the same job's material-step ROOT tuple, but the override
# remains explicitly off.  When enabled, it maps the primary-electron truth to
# CompleteTracks index 0 and requires every accepted-hit interval to match
# ordered sensitive-midpoint anchors within the configured distance guard.
gsf.TruthBHLossOverride = False
gsf.TruthBHLossSource = "G4StepTuple"
gsf.TruthBHLossInput = truthbhinputfilename
gsf.TruthBHLossInputTrackIndex = 0
gsf.TruthBHLossMaxEndpointDistance = 5.0

gsf.MaxComponents = 12
gsf.ReductionTargetComponents = 0
gsf.ReductionMergeCost = "SymmetricKL"
gsf.ComponentWeightCutoff = 1.0e-4
gsf.ProtectIdentityLineage = True

gsf.MSOn = True
gsf.ElossOn = True
gsf.KappaSeedCov = 1.0e-7

# Start with every backward workflow disabled. Each method block below enables
# exactly one; the algorithm also enforces their mutual exclusivity.
gsf.GaussianSumSmoothing = False
gsf.ReverseFiltering = False
gsf.CmsGsfSmoothing = False
gsf.CmsErrorRescaling = 100.0
gsf.MaterialIPExtrapolation = False
gsf.GSFOutputMode = "BestBranch"
gsf.ReverseOutputMode = "BestBranch"
gsf.ReverseSelectionMode = "AggregateWeight"
gsf.SurfaceConsistencyUninformativeFloor = 0.05
gsf.ReverseInitialWeightMode = "ForwardPosterior"
gsf.ReverseKappaSeedCov = 100.0

# Default-off research constraint.  When enabled for the reverse BestBranch
# workflow, GSFTracks stays tracker-only and GSFTracksEcalConstrained carries
# the paired component-selection result.  The input must contain EcalCluster.
gsf.EcalComponentConstraint = False
gsf.EcalConstraintRatioThreshold = 1.1
gsf.EcalConstraintLogPSigma = 0.15
gsf.EcalConstraintLikelihoodFloor = 0.05
gsf.EcalConstraintPhiWindow = 0.10
gsf.EcalConstraintThetaWindow = 0.10

if method == "smoother":
    # KL reduction-aware retained-graph Gaussian-sum smoother. Its common-IP
    # state is the moment-matched smoothed mixture.
    gsf.GaussianSumSmoothing = True
    gsf.GSFOutputMode = "WeightedMean"

elif method == "reverse":
    # Independent inward multi-component refit, seeded by the full final
    # forward posterior. Publish the highest aggregate-weight reverse branch.
    gsf.ReverseFiltering = True

elif method in ("cms-like", "cms", "cms_like"):
    # CMSSW-like workflow: seed from the final forward prediction, inflate the
    # full covariance, apply the outermost hit backward, combine collapsed
    # forward/backward moments internally, and publish the collapsed innermost
    # backward-filtered mixture at the IP.
    method = "cms-like"
    gsf.CmsGsfSmoothing = True
    gsf.CmsErrorRescaling = 100.0
    gsf.GSFOutputMode = "BestBranch"  # CMS endpoint selection is fixed.

else:
    raise ValueError(
        "Unknown method={!r}; choose smoother, reverse, or cms-like".format(
            method))

# Keep truth-oracle diagnostics paired with, but separate from, the ordinary
# GSF output.  With the default-off override this is exactly ``method`` and
# preserves the established filenames.
outputmethod = method + ("-truth-bh" if gsf.TruthBHLossOverride else "")

gsf.SelectedEventIndices = []
gsf.VerboseDump = False
gsf.VerboseSplitDump = False
gsf.ComponentDebugDump = False
gsf.SurfaceLineageMassDump = False
gsf.ComponentDebugMaxHistory = 240
gsf.MaterialTransitionCSV = ""
# Campaign diagnostic: the algorithm default remains empty/off. The generated
# input-sample/method name prevents different batch samples from overwriting it.
gsf.MaterialBHAuditCSV = os.path.join(
    tuplepath,
    "gsf_material_bh_audit_{}_{}.csv".format(
        os.path.splitext(os.path.basename(inputfilename))[0], outputmethod),
)
gsf.CounterfactualLossScan = False
gsf.CounterfactualTruthTransitionMap = ""
gsf.CounterfactualLossFractions = [
    0.04, 0.05, 0.06, 0.07, 0.08, 0.09, 0.10, 0.12,
]
gsf.CounterfactualLossVariance = 2.0e-4
gsf.OutputLevel = INFO

from Configurables import RecGsfFlatTuple
flat = RecGsfFlatTuple("RecGsfFlatTuple")
# The tuple always keeps ordinary gsf_* fields.  When the default-off ECAL
# experiment is enabled, it also fills ecal_gsf_* from the paired collection.
flat.OutputFile = os.path.join(
    tuplepath,
    "gsf_flat_{}_{}_{}.root".format(particle, outputmethod, inputseed),
)
flat.BField = 3.0
flat.HitCollectionNames = [
    "VXDTrackerHits",
    "ITKBarrelTrackerHits",
    "ITKEndcapTrackerHits",
    "TPCTrackerHits",
    "OTKBarrelTrackerHits",
    "OTKEndcapTrackerHits",
]

from Configurables import PodioOutput
out = PodioOutput("outputalg")
out.filename = os.path.join(
    tuplepath,
    "gsf_{}_{}_{}.root".format(particle, outputmethod, inputseed),
)
out.outputCommands = ["keep *"]

from Configurables import ApplicationMgr, MarlinEvtSeeder
evtseeder = MarlinEvtSeeder("EventSeeder")
ApplicationMgr(
    TopAlg=[podioinput, gsf, flat, out],
    EvtSel="NONE",
    EvtMax=evtmax,
    ExtSvc=[dsvc, geosvc, tracksys, gearsvc, evtseeder],
    OutputLevel=INFO,
)
