#!/usr/bin/env python
"""GSF comparison card with two explicitly selectable refit workflows.

Select exactly one workflow by editing the explicit ``method`` assignment
near the top of this file. The accepted values are ``"smoother"`` and
``"reverse"``.

Every workflow reads the same ``CompleteTracks`` collection, which supplies
the LCIO reference in the output tuple.
"""

# Maintenance contract: whenever a configurable RecGsfTracking property is
# added, renamed, removed, or changes its default/allowed values, a dedicated
# sub-agent must audit this card and Reconstruction/RecGsfTracking/README.md
# together; the parent agent verifies both against src/GsfAlgorithm.h.

import os
from Gaudi.Configuration import *

tuplepath = ""
evtmax = 12340
inputseed = 12340
particle = 12340
inputfilename = os.path.join(tuplepath, "trk_v01.root")

# Explicit workflow selection. Change this source line to "smoother",
# "reverse"; no environment override is used.
method = "reverse"

# One selector governs every workflow that consumes a Bethe-Heitler model.
bh_model = "CEPCRuntimeGenericGrid5Clear"

from Configurables import k4DataSvc
dsvc = k4DataSvc("EventDataSvc", input=inputfilename)

geometry_option = "TDR_o1_v01/TDR_o1_v01-onlyTracker.xml"
geometry_path = os.path.join(os.getenv("DETCRDROOT"), "compact", geometry_option)

from Configurables import DetGeomSvc
geosvc = DetGeomSvc("GeomSvc")
geosvc.compact = geometry_path

from Configurables import PodioInput
podioinput = PodioInput("PodioReader", collections=[
    "MCParticle",
    "VXDCollection",
    "ITKBarrelCollection", "ITKEndcapCollection",
    "TPCCollection",
    "OTKBarrelCollection", "OTKEndcapCollection",
    "VXDTrackerHits",
    "ITKBarrelTrackerHits", "ITKEndcapTrackerHits",
    "TPCTrackerHits",
    "OTKBarrelTrackerHits", "OTKEndcapTrackerHits",
    "VXDTrackerHitAssociation",
    "ITKBarrelTrackerHitAssociation", "ITKEndcapTrackerHitAssociation",
    "TPCTrackerHitAss",
    "OTKBarrelTrackerHitAssociation", "OTKEndcapTrackerHitAssociation",
    "CompleteTracks",
    "GsfG4MaterialSteps",
    "GsfSimTrackerHitG4StepLinks",
])

from Configurables import RecGsfTracking, TrackSystemSvc, GearSvc
tracksys = TrackSystemSvc("TrackSystemSvc")
gearsvc = GearSvc("GearSvc")

gsf = RecGsfTracking("RecGsfTracking")
gsf.ElectronHypothesis = True
# Common options used by the smoother/reverse comparisons.
# The production default is CEPC2GeV85StepConditioned. Default-off BH controls are
# CEPC2GeV85StepConditioned6, CEPCRuntimeGenericGrid5Clear,
# CEPCRuntimeCategoryAligned5Clear, CEPCRuntimeCategoryAligned9Clear,
# CEPCRuntimeCategoryAligned15Clear, and ActsAtlas. The four CEPCRuntime models
# are topology-clear interval-fit candidates and are not production validated;
# this maintained campaign card currently selects the generic-grid control.
gsf.BHModel = bh_model
# Production default; use CurrentSurface only as an explicit material control.
gsf.MaterialPathMode = "DD4hepBetweenSurfaces"
gsf.BHSplitThreshold = 1.0e-4
# Independent BH-process gates. This maintained reverse campaign deliberately
# suppresses outward splitting so the inward refit alone generates radiative
# hypotheses. Material-path evaluation/recording remains enabled in both
# directions. The compiled defaults are False/False; the reverse branch below
# is the explicit inward-only campaign override.
gsf.ForwardBHSplitting = False
gsf.InwardBHSplitting = False  # Neutral base; enabled only in reverse below.

# Strict Geant4 eBrem-loss oracle for diagnostic A/B tests only. Embedded
# EventData is its fixed source; no helper-file source/input steering remains.
# This template keeps the explicit off-side value; dump_gsftrk.sh replaces it
# from its truth_bh_override argument for an explicitly truth-on submission.
# When enabled, it maps CompleteTracks index 0 through the standard tracker-hit
# associations to the embedded SimTrackerHit-to-Geant4-step provenance. Every
# accepted-hit endpoint must pass the configured integrity guard. An invalid
# scope uses ordinary BH for the whole track and is tagged in
# GSFTruthBHLossStatus and the flat tuple. No side material ROOT file or
# runtime BH-audit CSV is produced by this maintained workflow.
gsf.TruthBHLossOverride = False
gsf.TruthBHLossInputTrackIndex = 0
gsf.TruthBHLossMaxEndpointDistance = 5.0
# RecordTruthMaterialIntervals deliberately inherits its compiled default true.
# Its two embedded provenance collections are unconditional PodioInput members
# above, so ordinary maintained cards do not need conditional truth-input
# steering. The recorder remains passive and cannot alter filtering/selection.

gsf.MaxComponents = 10
gsf.ReductionTargetComponents = 0
gsf.ReductionMergeCost = "SymmetricKL"
gsf.ComponentWeightCutoff = 1.0e-4
gsf.ProtectIdentityLineage = True

gsf.MSOn = True
gsf.ElossOn = True
# Use the exact standard-KF prefit curvature variance; positive values are a
# legacy diagnostic override in kappa units.
gsf.KappaSeedCov = -1.0  # <=0 uses the standard forward Var(omega)=1e-4.

# Initialize the neutral backward-workflow baseline before selecting a method.
# Each branch below repeats only the options that belong to that method.
gsf.GaussianSumSmoothing = False
gsf.ReverseFiltering = False
# Positive: copy/scale the final forward mixture. <=0: one fresh backward
# standard-KF-style seed with the outermost hit already updated. The value -1
# is a mode selector, not a negative covariance multiplier.
gsf.InwardSeedCovarianceScale = -1.0
# Live reverse-component weighting. LocalMeasurement is the compiled/default
# control. The maintained reverse campaign explicitly selects the experimental
# SmoothedMarginal mode below; propagated means/covariances remain B_updated.
gsf.InwardWeightMode = "SmoothedMarginal" #"LocalMeasurement"
gsf.MaterialIPExtrapolation = False
# Forward-only compatibility setting. The smoother/reverse methods
# below always persist all three endpoint representations and do not select one
# here.
gsf.GSFOutputMode = "BestBranch"
gsf.ReverseSelectionMode = "AggregateWeight"
gsf.SurfaceConsistencyUninformativeFloor = 0.05
gsf.ReverseInitialWeightMode = "ForwardPosterior"

# Default-off research constraint.  When enabled from a separate reconstructed-
# event card that supplies EcalCluster, GSFTracksBestBranch stays tracker-only and
# GSFTracksEcalConstrained carries the paired component-selection result.  The
# maintained tracker-direct worker keeps this off and does not request clusters.
gsf.EcalComponentConstraint = False
gsf.EcalConstraintRatioThreshold = 1.1
gsf.EcalConstraintLogPSigma = 0.15
gsf.EcalConstraintLikelihoodFloor = 0.05
gsf.EcalConstraintPhiWindow = 0.10
gsf.EcalConstraintThetaWindow = 0.10

if method == "smoother":
    # KL reduction-aware retained-graph Gaussian-sum smoother. Its common-IP
    # state is persisted as GSFTracksBestBranch, GSFTracksWeightedMean, and
    # GSFTracksFullMixtureMode; these are currently expected to be identical.
    gsf.GaussianSumSmoothing = True

elif method == "reverse":
    # Independent inward multi-component refit. With the maintained nonpositive
    # inward-scale steering it starts from one fresh standard-KF-style seed;
    # positive values instead copy the full final forward posterior. Persist
    # the selected branch in GSFTracksBestBranch and
    # the two automatic full-mixture summaries in GSFTracksWeightedMean and
    # GSFTracksFullMixtureMode. The latter is the joint five-dimensional PDF
    # maximum; GSFFullMixtureModeStatus tags optimization success/fallback.
    # The final positive-weight component weights, IP kappas, and kappa
    # variances are also recorded automatically; there is no steering switch.
    # The complete component-lineage DAG is likewise automatic/default-on in
    # the EDM and flat tuple. It retains evaluated nodes after measurement
    # rejection, weight cutoff, or KL merging. It also records every retained
    # interior B_smoothed[i] = F_updated[i] x B_predicted[i] product; the
    # boundary states reuse B_updated[0] and F_updated[N-1]. SmoothedMarginal
    # sums the unreduced pair posterior over forward partners for each
    # backward candidate and attaches that weight to its B_updated state before
    # cutoff/KL and the next inward propagation. It deliberately reuses
    # overlapping forward evidence at successive surfaces and is not a
    # calibrated Bayesian posterior.
    gsf.ReverseFiltering = True
    gsf.InwardBHSplitting = True
    gsf.InwardWeightMode = "SmoothedMarginal"
    gsf.ReverseSelectionMode = "AggregateWeight" # equivalent bestbranch
    gsf.SurfaceConsistencyUninformativeFloor = 0.05
    # Inert for the maintained fresh single-component inward seed; retained
    # explicitly for positive-scale copied-mixture comparison cards.
    gsf.ReverseInitialWeightMode = "ForwardPosterior"

else:
    raise ValueError(
        "Unknown method={!r}; choose smoother or reverse".format(
            method))

# Keep ordinary GSF truth-oracle A/B sides explicitly tagged.
outputmethod = method + (
    "-truth-bh" if gsf.TruthBHLossOverride else "-truth-bh-off"
)

gsf.SelectedEventIndices = []
gsf.VerboseDump = False
gsf.VerboseSplitDump = False
gsf.ComponentDebugDump = False
gsf.SurfaceLineageMassDump = False
gsf.ComponentDebugMaxHistory = 240
gsf.OutputLevel = INFO

from Configurables import RecGsfFlatTuple
flat = RecGsfFlatTuple("RecGsfFlatTuple")
# The tuple uses explicit endpoint schemas. Smoother/reverse BestBranch,
# WeightedMean, and FullMixtureMode fill bestbranch_gsf_*, weighted_gsf_*, and
# fullmixture_gsf_* respectively. Missing method-specific collections leave
# their corresponding branch set
# unavailable/zero. The always-created final_mixture_component_* vectors carry
# all final smoother/reverse output tracks and are empty for forward.
# The lineage_node_* and lineage_edge_* vectors automatically carry the full
# passive smoother/reverse component DAG and are empty for the other methods.
flat.OutputFile = os.path.join(
    tuplepath,
    "gsf_flat_{}_{}_{}.root".format(particle, outputmethod, inputseed),
)
flat.BField = 3.0
flat.HitCollectionNames = [
    "VXDTrackerHits",
    "ITKBarrelTrackerHits",
    "ITKEndcapTrackerHits",
    "TPCTrackerHits",
    "OTKBarrelTrackerHits",
    "OTKEndcapTrackerHits",
]

from Configurables import PodioOutput
out = PodioOutput("outputalg")
out.filename = os.path.join(
    tuplepath,
    "gsf_{}_{}_{}.root".format(particle, outputmethod, inputseed),
)
out.outputCommands = ["keep *"]

from Configurables import ApplicationMgr, MarlinEvtSeeder
evtseeder = MarlinEvtSeeder("EventSeeder")
ApplicationMgr(
    TopAlg=[podioinput, gsf, flat, out],
    EvtSel="NONE",
    EvtMax=evtmax,
    ExtSvc=[dsvc, geosvc, tracksys, gearsvc, evtseeder],
    OutputLevel=INFO,
)
